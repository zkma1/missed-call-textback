# Rename this to ".env" and fill in. (On Render/Replit, set these as environment variables instead.)

# --- Twilio credentials (Console > Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Your Twilio number in E.164 format
TWILIO_NUMBER=+15551234567

# Optional: your real phone to ring first. Leave BLANK for demo mode
# (every call is treated as missed and always gets the text back).
FORWARD_TO=

# The public https URL of THIS deployed server (no trailing slash).
# e.g. https://missed-call-textback.onrender.com
PUBLIC_URL=

# --- Message copy ---
BUSINESS_NAME=Acme Dental
BOOKING_LINK=https://cal.com/your-handle

PORT=3000
